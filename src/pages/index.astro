---
import '../styles/global.css';
import DownloadButton from '../components/DownloadButton.astro';
import AppPreview from '../components/AppPreview.astro';
import Features from '../components/Features.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ReaderDetails from '../components/ReaderDetails.astro';
import { repositoryUrl, releaseUrl, releaseLicenseUrl, sourceLicenseUrl } from '../config/product';

const title = 'simPl — A lightweight, offline reader for Windows';
const description = 'Read PDF, EPUB, HTML, text and Markdown in a quiet, native Windows reader. Local, source-available, and free for personal and professional use.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0c0c" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="simPl" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <ThemeToggle />
    <main class="page-shell" id="main">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">simPl</h1>
        <p class="hero-description">A lightweight reader.<br />A quiet place for your books.</p>
        <p class="hero-intro">Read PDF, EPUB, HTML and Markdown on Windows,<br class="desktop-break" /> and pick up where you left off.</p>
        <DownloadButton />
      </section>
      <AppPreview />
      <Features />
      <ReaderDetails />
      <footer class="page-footer">
        <p>Just you and your next chapter.</p>
        <nav aria-label="Project links">
          <a href={repositoryUrl}>GitHub</a>
          <a href={releaseUrl}>Release notes</a>
          <a href={releaseLicenseUrl}>Terms of use</a>
          <a href={sourceLicenseUrl}>Source license</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
