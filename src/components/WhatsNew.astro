---
import { Image } from 'astro:assets';
import listenShot from '../assets/screens/crop-listen.webp';
import translateShot from '../assets/screens/crop-translate.webp';
import backupShot from '../assets/screens/crop-backup.webp';
import typographyShot from '../assets/screens/crop-typography.webp';
import { releaseVersion, releaseUrl } from '../config/product';

const items = [
  {
    kicker: 'Listen',
    title: 'Let the book read to you.',
    body: 'Press Listen and simPl reads on, page after page and chapter after chapter, with the voices already in Windows. The page follows along and a soft marker keeps your place. Pause, change the speed, or read just a selected passage.',
    notes: ['Works offline', 'Ctrl+Shift+U'],
    src: listenShot,
    alt: 'Listen paused in the middle of a sentence, with the spoken word marked and the speed controls open',
  },
  {
    kicker: 'Word translation',
    title: 'Look up a word without leaving the page.',
    body: 'Double-click a word to see its meaning. Download only the dictionaries you need, then every lookup happens on your computer. No document text is sent anywhere.',
    notes: ['13 language directions', 'Optional downloads'],
    src: translateShot,
    alt: 'An English → Turkish dictionary card open over the word “book” in a highlighted sentence',
    credit: true,
  },
  {
    kicker: 'Your data',
    title: 'Back up your library. Keep your notes.',
    body: 'Create and restore verified backups with your shelves, positions, highlights and notes, and optionally the books themselves. Export bookmarks, quotes and notes as Markdown, text or JSON.',
    notes: ['ZIP backups', 'Markdown · Text · JSON'],
    src: backupShot,
    alt: 'Library & data settings with backup options and note export formats',
  },
  {
    kicker: 'Reading comfort',
    title: 'Make each book your own.',
    body: 'Choose the font, text size, line spacing and side margins, and each reflowable book remembers its settings. Fit the page to the window, or go fullscreen and leave only the text.',
    notes: ['F11 fullscreen', 'Ctrl+Shift+F fit width'],
    src: typographyShot,
    alt: 'Per-book reading settings for font, text size, line spacing and side margins',
  },
];
---

<section class="whats-new" id="new" aria-labelledby="new-title">
  <header class="section-head">
    <p class="eyebrow">New in {releaseVersion}</p>
    <h2 id="new-title">More ways to read.<br />Still just as quiet.</h2>
    <p>Listening, offline word lookups and a safer home for your notes, without adding clutter to the page. <a href={releaseUrl}>Release notes</a></p>
  </header>
  <ol class="new-list">
    {items.map((item) => (
      <li class="new-item">
        <div class="new-copy">
          <p class="new-kicker">{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <ul class="new-notes">
            {item.notes.map((note) => <li>{note}</li>)}
          </ul>
        </div>
        <figure class="new-shot">
          <Image src={item.src} alt={item.alt} widths={[400, 640, 960]}
            sizes="(max-width: 48rem) calc(100vw - 48px), 460px" format="webp" quality={85} loading="lazy" decoding="async" />
          {item.credit && (
            <figcaption>Dictionary data: <a href="https://www.wikdict.com/page/about">WikDict</a>, from Wiktionary contributors, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></figcaption>
          )}
        </figure>
      </li>
    ))}
  </ol>
</section>

<style>
  .whats-new { width: 100%; max-width: 52rem; border-top: 1px solid var(--surface-border); padding-top: clamp(2.5rem, 7vw, 4.5rem); scroll-margin-top: 2rem; }
  .section-head { max-width: 34rem; margin: 0 auto clamp(2.5rem, 7vw, 4.5rem); text-align: center; }
  .eyebrow {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--surface-border);
    border-radius: 999px;
    color: var(--secondary);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
  }
  .section-head h2 { margin: 0 0 1rem; font-size: clamp(1.75rem, 4.2vw, 2.5rem); font-weight: 520; line-height: 1.15; letter-spacing: -0.045em; }
  .section-head p:last-child { margin: 0; color: var(--secondary); font-size: 0.9375rem; line-height: 1.7; text-wrap: pretty; }
  .section-head a { margin-left: 0.25rem; white-space: nowrap; text-underline-offset: 4px; text-decoration-color: var(--surface-border); }
  .section-head a:hover { color: var(--foreground); text-decoration-color: currentColor; }
  .new-list { display: grid; gap: clamp(3rem, 8vw, 5.5rem); margin: 0; padding: 0; list-style: none; }
  .new-item { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(1.5rem, 5vw, 3.5rem); }
  .new-item:nth-child(even) .new-copy { order: 2; }
  .new-kicker { margin: 0 0 0.6rem; color: var(--muted); font-size: 0.8125rem; }
  .new-copy h3 { margin: 0 0 0.85rem; font-size: clamp(1.25rem, 2.6vw, 1.5rem); font-weight: 520; line-height: 1.25; letter-spacing: -0.035em; text-wrap: balance; }
  .new-copy > p:not(.new-kicker) { margin: 0; color: var(--secondary); font-size: 0.9063rem; line-height: 1.7; text-wrap: pretty; }
  .new-notes { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.1rem 0 0; padding: 0; list-style: none; }
  .new-notes li { padding: 0.2rem 0.6rem; border-radius: 0.4rem; background: var(--surface); border: 1px solid var(--surface-border); color: var(--secondary); font-size: 0.75rem; }
  .new-shot { margin: 0; }
  .new-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--surface-border);
    border-radius: 0.75rem;
    box-shadow: var(--frame-shadow);
  }
  .new-shot figcaption { margin-top: 0.6rem; color: var(--muted); font-size: 0.6875rem; line-height: 1.5; }
  .new-shot figcaption a { text-underline-offset: 3px; text-decoration-color: var(--surface-border); }
  .new-shot figcaption a:hover { color: var(--foreground); }

  /* Progressive enhancement: rows ease in as they scroll into view. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .new-item { animation: rise-in linear both; animation-timeline: view(); animation-range: entry 0% entry 55%; }
    }
  }
  @keyframes rise-in { from { opacity: 0; transform: translateY(1.5rem); } to { opacity: 1; transform: none; } }

  @media (max-width: 48rem) {
    .new-item { grid-template-columns: 1fr; }
    .new-item:nth-child(even) .new-copy { order: 0; }
  }
</style>
