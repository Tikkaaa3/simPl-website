---
import FeatureRows, { type FeatureRow } from './FeatureRows.astro';
import toolsShot from '../assets/screens/crop-tools.webp';
import toolsHiddenShot from '../assets/screens/crop-tools-hidden.webp';
import progressShot from '../assets/screens/crop-progress.webp';
import aaShot from '../assets/screens/crop-aa.webp';
import toolsDark from '../assets/screens/crop-tools-dark.webp';
import toolsHiddenDark from '../assets/screens/crop-tools-hidden-dark.webp';
import progressDark from '../assets/screens/crop-progress-dark.webp';
import aaDark from '../assets/screens/crop-aa-dark.webp';
import { featuredVersion } from '../config/product';

// One sentence each. Details belong in the FAQ and the changelog.
const items: FeatureRow[] = [
  {
    title: 'Tools that step aside.',
    body: 'The reading tools hide as soon as you scroll, and come back when you point at the title bar.',
    src: toolsHiddenShot,
    dark: toolsHiddenDark,
    fadeTo: toolsShot,
    fadeToDark: toolsDark,
    alt: 'A book open in simPl with the title bar on top and the pill of reading tools under it',
  },
  {
    title: 'See where you are.',
    body: 'A thin line along the bottom shows your progress, cut into the book’s chapters.',
    src: progressShot,
    dark: progressDark,
    alt: 'The progress line along the bottom of the page, cut into chapters, with the page a click would jump to',
  },
  {
    title: 'A theme for each book.',
    body: 'Aa sets the theme, font and spacing of the book you have open, and the book remembers them.',
    src: aaShot,
    dark: aaDark,
    alt: 'The Aa panel with the four themes and this book’s text size, font, line spacing and side margins',
  },
];
---

<section class="page-section" id="new" aria-labelledby="new-title">
  <header class="section-head">
    <h2 id="new-title">New in {featuredVersion}</h2>
    <p><a href="/changelog/">All changes</a></p>
  </header>
  <FeatureRows items={items} />
</section>
