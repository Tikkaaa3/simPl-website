---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type FeatureRow = {
  title: string;
  body: string;
  /** The capture shown on the light page, and on both when there is no `dark`. */
  src: ImageMetadata;
  /** The same view captured in the reader's dark appearance. */
  dark?: ImageMetadata;
  alt: string;
  /** A second capture of the same view, cross-faded with `src` to show a change. */
  fadeTo?: ImageMetadata;
  fadeToDark?: ImageMetadata;
  /** Sets the row's id, for links from elsewhere. */
  id?: string;
  /** Shows the dictionary data credit under the image. */
  credit?: boolean;
};

interface Props { items: FeatureRow[] }
const { items } = Astro.props;
const widths = [400, 640, 960];
const sizes = '(max-width: 48rem) calc(100vw - 48px), 460px';
---

<ol class="row-list">
  {items.map((item) => (
    <li class="row" id={item.id}>
      <div class="row-copy">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </div>
      <figure class="row-shot">
        <div class:list={['row-frame', { 'row-fade': item.fadeTo }]}>
          {item.dark && (
            <Image class="shot-dark" src={item.dark} alt={item.alt} widths={widths} sizes={sizes} format="webp" quality={85} loading="lazy" decoding="async" />
          )}
          <Image class:list={[{ 'shot-light': item.dark }]} src={item.src} alt={item.alt} widths={widths} sizes={sizes} format="webp" quality={85} loading="lazy" decoding="async" />
          {item.fadeTo && item.fadeToDark && (
            <Image class="row-fade-top shot-dark" src={item.fadeToDark} alt="" widths={widths} sizes={sizes} format="webp" quality={85} loading="lazy" decoding="async" />
          )}
          {item.fadeTo && (
            <Image class:list={['row-fade-top', { 'shot-light': item.fadeToDark }]} src={item.fadeTo} alt="" widths={widths} sizes={sizes} format="webp" quality={85} loading="lazy" decoding="async" />
          )}
        </div>
        {item.credit && (
          <figcaption>Dictionary data: <a href="https://www.wikdict.com/page/about">WikDict</a> (Karl Bartel), <a href="https://www.wiktionary.org/">Wiktionary contributors</a> via <a href="https://kaiko.getalp.org/about-dbnary/">DBnary</a> — <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC BY-SA 4.0</a>. Normalized and excerpted by simPl. Cropped screenshot. <a href="/credits/#dictionary-screenshot">Sources and license</a>.</figcaption>
        )}
      </figure>
    </li>
  ))}
</ol>

<style>
  .row-list { display: grid; gap: clamp(3rem, 8vw, 5rem); margin: 0; padding: 0; list-style: none; }
  .row { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: center; gap: clamp(1.5rem, 5vw, 3.5rem); scroll-margin-top: 2rem; }
  .row:nth-child(even) { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
  .row:nth-child(even) .row-copy { order: 2; }
  .row-copy h3 { margin: 0 0 0.7rem; font-size: 1.25rem; font-weight: 520; line-height: 1.3; letter-spacing: -0.03em; text-wrap: balance; }
  .row-copy p { margin: 0; color: var(--secondary); font-size: 0.9375rem; line-height: 1.7; text-wrap: pretty; }
  .row-shot { margin: 0; }
  .row-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--surface-border);
    border-radius: 0.75rem;
    box-shadow: var(--frame-shadow);
  }
  .row-frame img { display: block; width: 100%; height: auto; }
  .row-fade-top { position: absolute; inset: 0; opacity: 0; }
  .row-shot figcaption { margin-top: 0.75rem; color: var(--muted); font-size: 0.75rem; line-height: 1.65; }
  .row-shot figcaption a { text-underline-offset: 3px; }
  .row-shot figcaption a:hover { color: var(--foreground); }

  /* The second capture fades in and out, like the tools hiding while you read. */
  @media (prefers-reduced-motion: no-preference) {
    .row-fade-top { animation: row-fade 7s ease-in-out infinite; }
  }
  @keyframes row-fade { 0%, 35% { opacity: 0; } 45%, 90% { opacity: 1; } 100% { opacity: 0; } }

  @media (max-width: 48rem) {
    .row, .row:nth-child(even) { grid-template-columns: 1fr; }
    .row:nth-child(even) .row-copy { order: 0; }
  }
</style>
