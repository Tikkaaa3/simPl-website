---
import { windowsDownloadUrl, releaseUrl, releaseVersion, downloadSize, androidDownloadUrl, androidDownloadSize, androidReleaseUrl, androidVersion } from '../config/product';
---

<div class="download" id="download">
  <div class="download-actions">
  {windowsDownloadUrl ? (
    <a class="download-button" href={windowsDownloadUrl} download>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="18" height="18">
        <path d="M1 1h8v8H1zm10 0h8v8h-8zM1 11h8v8H1zm10 0h8v8h-8z" />
      </svg>
      Download for Windows
      <svg class="download-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="18" height="18">
        <path d="M10 2.5v10m-4-4 4 4 4-4M3 13v4h14v-4" />
      </svg>
    </a>
  ) : (
    <button class="download-button" type="button" disabled aria-describedby="download-status">
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="18" height="18">
        <path d="M1 1h8v8H1zm10 0h8v8h-8zM1 11h8v8H1zm10 0h8v8h-8z" />
      </svg>
      Download for Windows
      <svg class="download-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="18" height="18">
        <path d="M10 2.5v10m-4-4 4 4 4-4M3 13v4h14v-4" />
      </svg>
    </button>
  )}
  {androidDownloadUrl && (
    <a class="download-button" href={androidDownloadUrl} download>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="18" height="18">
        <path d="M5.5 4.2 4.3 2.1a.4.4 0 0 1 .7-.4l1.2 2.1A8 8 0 0 1 10 3a8 8 0 0 1 3.8.8L15 1.7a.4.4 0 0 1 .7.4l-1.2 2.1A6.6 6.6 0 0 1 17 9H3a6.6 6.6 0 0 1 2.5-4.8ZM7 6.8a.8.8 0 1 0 0-1.6.8.8 0 0 0 0 1.6Zm6 0a.8.8 0 1 0 0-1.6.8.8 0 0 0 0 1.6ZM3 10h14v6a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 16Z" />
      </svg>
      Download for Android
      <svg class="download-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="18" height="18">
        <path d="M10 2.5v10m-4-4 4 4 4-4M3 13v4h14v-4" />
      </svg>
    </a>
  )}
  </div>
  {/* One quiet line. Portable ZIP, universal APK, terms and checksums are in the FAQ. */}
  <p class="download-meta" id="download-status">
    <span>Free</span>
    {windowsDownloadUrl
      ? <span>Windows x64 <a href={releaseUrl}>v{releaseVersion}</a>, {downloadSize}</span>
      : <span>Windows download not available yet</span>}
    {androidDownloadUrl && <span>Android 8.0+ <a href={androidReleaseUrl}>v{androidVersion}</a>, {androidDownloadSize}</span>}
  </p>
</div>

<style>
  .download { scroll-margin-top: 3rem; }
  .download-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .download-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.15rem 0; margin: 1.1rem 0 0; color: var(--muted); font-size: 0.8125rem; line-height: 1.6; }
  .download-meta span + span::before { content: '·'; padding-inline: 0.6rem; }
  .download-meta a { text-underline-offset: 3px; text-decoration-color: var(--surface-border); }
  .download-meta a:hover { color: var(--foreground); text-decoration-color: currentColor; }
  .download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 3.5rem;
    padding: 1rem 1.3rem;
    border: 1px solid var(--button-border);
    border-radius: 0.45rem;
    background: var(--button-background);
    color: var(--button-foreground);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease;
  }
  .download-button:disabled { cursor: not-allowed; }
  a.download-button:hover { background: var(--button-background-hover); border-color: var(--button-background-hover); }
  .download-arrow { margin-left: 0.7rem; opacity: 0.65; }
  @media (prefers-reduced-motion: reduce) {
    .download-button { transition: none; }
  }
</style>
