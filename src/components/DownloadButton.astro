---
import { windowsDownloadUrl, repositoryUrl, releaseUrl, releaseVersion, downloadSize, releaseLicenseUrl } from '../config/product';
---

<div class="download" id="download">
  <div class="download-actions">
  {windowsDownloadUrl ? (
    <a class="download-button" href={windowsDownloadUrl} download>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="18" height="18">
        <path d="M1 1h8v8H1zm10 0h8v8h-8zM1 11h8v8H1zm10 0h8v8h-8z" />
      </svg>
      Download for Windows
      <svg class="download-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="18" height="18">
        <path d="M10 2.5v10m-4-4 4 4 4-4M3 13v4h14v-4" />
      </svg>
    </a>
  ) : (
    <button class="download-button" type="button" disabled aria-describedby="download-status">
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="18" height="18">
        <path d="M1 1h8v8H1zm10 0h8v8h-8zM1 11h8v8H1zm10 0h8v8h-8z" />
      </svg>
      Download for Windows
      <svg class="download-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="18" height="18">
        <path d="M10 2.5v10m-4-4 4 4 4-4M3 13v4h14v-4" />
      </svg>
    </button>
  )}
    <a class="source-link" href={repositoryUrl}>View source on GitHub <span aria-hidden="true">↗</span></a>
  </div>
  {windowsDownloadUrl ? (
    <>
      <p class="download-terms">Free for personal and professional use <span aria-hidden="true">·</span> <a href={releaseLicenseUrl}>Terms</a></p>
      <p class="download-meta">Windows x64 <span>·</span> <a href={releaseUrl}>v{releaseVersion}</a> <span>·</span> {downloadSize}</p>
    </>
  ) : <p class="download-meta" id="download-status">Windows download not available yet</p>}
</div>

<style>
  .download { scroll-margin-top: 3rem; }
  .download-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .source-link { font-size: 0.875rem; text-decoration: none; color: var(--secondary); padding-block: 0.5rem; }
  .source-link:hover { color: var(--foreground); text-decoration: underline; text-underline-offset: 4px; }
  .source-link span { margin-left: 0.25rem; }
  .download-terms { margin: 1rem 0 0; color: var(--secondary); font-size: 0.8125rem; line-height: 1.6; }
  .download-terms span { padding-inline: 0.35rem; color: var(--muted); }
  .download-terms a { text-underline-offset: 3px; text-decoration-color: var(--surface-border); }
  .download-terms a:hover { color: var(--foreground); text-decoration-color: currentColor; }
  .download-meta { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.8125rem; line-height: 1.6; }
  .download-actions + .download-meta { margin-top: 1rem; }
  .download-meta span { padding-inline: 0.35rem; }
  .download-meta a { text-underline-offset: 3px; }
  .download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 3.5rem;
    padding: 1rem 1.3rem;
    border: 1px solid var(--button-border);
    border-radius: 0.45rem;
    background: var(--button-background);
    color: var(--button-foreground);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease;
  }
  .download-button:disabled { cursor: not-allowed; }
  a.download-button:hover { background: var(--button-background-hover); border-color: var(--button-background-hover); }
  .download-arrow { margin-left: 0.7rem; opacity: 0.65; }
  @media (prefers-reduced-motion: reduce) {
    .download-button { transition: none; }
  }
</style>
