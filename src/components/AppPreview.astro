---
import { Image } from 'astro:assets';
import darkShot from '../assets/app-preview-dark.png';
import readingShot from '../assets/app-preview-reading.png';
import lightShot from '../assets/app-preview-light.png';

const slides = [
  { src: readingShot, label: 'Reading', alt: 'A book open in simPl’s dark reading view, with page navigation and zoom controls', caption: 'A quiet page, comfortable type, and your place saved for next time.' },
  { src: darkShot, label: 'Your library', alt: 'The simPl local library in dark appearance', caption: 'Keep your books together. Find a favourite or pick up where you left off.' },
  { src: lightShot, label: 'Light appearance', alt: 'The simPl local library in light appearance', caption: 'Light or dark. The same familiar space, in the appearance you prefer.' },
];
---

<section class="app-preview" aria-label="Explore simPl">
  <fieldset class="preview-picker">
    <legend class="visually-hidden">Choose an application preview</legend>
    {slides.map((slide, index) => (
      <label class="preview-choice">
        <input class="visually-hidden" type="radio" name="app-preview" id={`app-preview-${index + 1}`} checked={index === 0} aria-controls={`preview-panel-${index + 1}`} />
        <span>{slide.label}</span>
      </label>
    ))}
  </fieldset>
  {slides.map((slide, index) => (
    <figure class="preview-panel" id={`preview-panel-${index + 1}`}>
      <div class="preview-frame">
        <Image src={slide.src} alt={slide.alt} widths={[480, 832, 1280, 1664]}
          sizes="(max-width: 880px) calc(100vw - 48px), 832px" format="webp" quality={85}
          loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
      </div>
      <figcaption>{slide.caption}</figcaption>
    </figure>
  ))}
</section>

<style>
  .app-preview { width: 100%; max-width: 52rem; }
  .preview-picker { display: flex; justify-content: center; gap: 0.25rem; border: 0; padding: 0; margin: 0 0 1rem; min-width: 0; }
  .preview-choice { position: relative; cursor: pointer; }
  .preview-choice span { display: block; padding: 0.75rem 1rem; border-bottom: 1px solid transparent; color: var(--muted); font-size: 0.8125rem; }
  .preview-choice:hover span { color: var(--foreground); }
  .preview-choice:has(input:checked) span { border-color: var(--foreground); color: var(--foreground); }
  .preview-choice:has(input:focus-visible) { outline: 2px solid var(--foreground); outline-offset: 3px; border-radius: 3px; }
  .preview-panel { display: none; margin: 0; }
  .app-preview:has(#app-preview-1:checked) #preview-panel-1,
  .app-preview:has(#app-preview-2:checked) #preview-panel-2,
  .app-preview:has(#app-preview-3:checked) #preview-panel-3 { display: block; }
  .preview-frame { border: 1px solid var(--surface-border); border-radius: 0.75rem; overflow: hidden; background: var(--surface); }
  .preview-frame img { display: block; width: 100%; height: auto; }
  figcaption { min-height: 3rem; margin-top: 1rem; color: var(--secondary); font-size: 0.8125rem; line-height: 1.6; text-align: center; text-wrap: balance; }
  @media (max-width: 42rem) { .preview-choice span { padding-inline: 0.6rem; font-size: 0.75rem; } }
</style>
