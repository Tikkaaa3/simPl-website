---
import { repositoryUrl, downloadSize, releaseLicenseUrl } from '../config/product';
---

<section class="page-section features" aria-labelledby="features-title">
  <header class="section-head">
    <h2 id="features-title">And nothing you don’t need.</h2>
  </header>
  <ul>
    <li>
      <h3>Lightweight</h3>
      <p>A native {downloadSize} download that opens quickly.</p>
    </li>
    <li>
      <h3>Local and offline</h3>
      <p>No account. Your books and notes stay on your device.</p>
    </li>
    <li>
      <h3>Shelves</h3>
      <p>Group, filter and sort your books your way.</p>
    </li>
    <li>
      <h3>Free and open to read</h3>
      <p><a href={releaseLicenseUrl}>Free to use</a>, at home and at work. The code is <a href={repositoryUrl}>on GitHub</a>.</p>
    </li>
  </ul>
</section>
